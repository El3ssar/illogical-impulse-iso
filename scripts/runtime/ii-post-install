#!/usr/bin/env bash
# Calamares shellprocess@post-install hook. Runs INSIDE the installed chroot
# AFTER unpackfs + users module. Finishes user-facing setup that can't be
# expressed as static files.
#
# Fail-soft by design: a failed `try` warns but doesn't abort the install.
# A bricked install is worse than a missed tweak the user can fix later.

set -u
LOG=/var/log/ii-post-install.log
mkdir -p "$(dirname "$LOG")"
[[ -f /usr/local/lib/ii/session-offline.sh ]] && source /usr/local/lib/ii/session-offline.sh
# ledger.sh is a survive-path lib (ii-verify keeps it). Sourced guarded for
# parity with session-offline; the actual install-time row is recorded as the
# NEW USER further below so it lands in their state dir, not root's.
[[ -f /usr/local/lib/ii/ledger.sh ]] && source /usr/local/lib/ii/ledger.sh
# mutator.sh is a survive-path lib too — it gives us the idempotent, ledger-
# recording ii_group_add primitive (it re-sources ledger.sh harmlessly). Used
# for the install-time group memberships below so `iictl revert-all --deep` can
# peel exactly the ones we add.
[[ -f /usr/local/lib/ii/mutator.sh ]] && source /usr/local/lib/ii/mutator.sh
# nvidia-classify.sh is a pure (no-I/O) lib: the open/legacy/nouveau PCI-id
# classifier extracted from the inline loop below (HW-01) so it is unit-testable
# in isolation. Sourced guarded; the NVIDIA block has a raw-inline fallback if it
# is somehow absent (dev checkout).
[[ -f /usr/local/lib/ii/nvidia-classify.sh ]] && source /usr/local/lib/ii/nvidia-classify.sh
type ii_tee_log &>/dev/null && ii_tee_log "$LOG" \
  || { exec 3>&1; exec > >(tee -a "$LOG" >&3); exec 2>&1; }

T()   { echo "[post-install] $*"; }
try() { local d="$1"; shift; if "$@"; then T "  ok    $d"; else T "  warn  $d (rc=$?)"; fi; }

# ii_group_add_for <home> <user> <group...> — run the sourced ii_group_add
# mutator (install-tagged) so its ledger row lands in the NEW USER's state dir.
# ii_group_add is a shell function, so it can't go through `env <fn>`; we run a
# fresh bash that re-sources mutator.sh with HOME/XDG_STATE_HOME pointed at the
# user and II_GROUP_SRC=install set (real assignments, not a prefix on `source`).
# The mutation needs root; afterwards we chown any dirs we just created so the
# ledger is owned by the new user (revert-all runs as them).
ii_group_add_for() {
  local home="$1" user="$2"; shift 2
  HOME="$home" XDG_STATE_HOME="$home/.local/state" II_GROUP_SRC=install \
    bash -c 'source /usr/local/lib/ii/mutator.sh; ii_group_add "$@"' _ "$user" "$@"
  local rc=$?
  # Fix ownership up the chain we may have created as root (state dir/.local
  # usually pre-exist from skel, but a reused /home without skel may not).
  local d="$home/.local" s="$home/.local/state" l="$home/.local/state/illogical-impulse"
  [[ -d "$l" ]] && chown -R "$user:$user" "$l" 2>/dev/null || true
  [[ -d "$s" ]] && chown "$user:$user" "$s" 2>/dev/null || true
  [[ -d "$d" ]] && chown "$user:$user" "$d" 2>/dev/null || true
  return $rc
}

T "==== $(date -u +%FT%TZ) ===="

# ── identify the user Calamares just created ───────────────────────────────
NEW_USER=$(getent passwd 2>/dev/null \
  | awk -F: '$3>=1000 && $3<65534 && $1!="liveuser" && $1!="nobody" {print $1; exit}')
T "new user: ${NEW_USER:-<unknown>}"

# ── groups ─────────────────────────────────────────────────────────────────
# Route the six baseline memberships (video input i2c render audio wheel) through
# the idempotent ledger-recording ii_group_add mutator (it groupadd -f's each
# group first, so the old standalone `groupadd -f i2c` is subsumed) instead of a
# raw `usermod -aG`. ii_group_add records ONLY the memberships it actually adds,
# tagged src=install (via II_GROUP_SRC) so revert-all's _is_install_row gates them
# under --deep — a plain `iictl revert-all` leaves them (wheel is load-bearing:
# it makes the baked nopasswd-sudo drop-in effective), but `--deep` peels them
# back to the user's pre-existing groups. The mutation needs root, but the ledger
# row must land in the NEW USER's state dir (revert-all runs as them) — so we
# point HOME/XDG_STATE_HOME at the user's home and chown the ledger to them after,
# mirroring the docker block's "record as the new user" intent.
if [[ -n "$NEW_USER" ]] && type ii_group_add &>/dev/null; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  if [[ -n "$H" && -d "$H" ]]; then
    try "ledger group memberships ($NEW_USER)" \
      ii_group_add_for "$H" "$NEW_USER" video input i2c render audio wheel
  fi
elif [[ -n "$NEW_USER" ]]; then
  # mutator.sh unavailable (dev checkout) — fall back to the raw adds, unledgered.
  try "groupadd i2c"               groupadd -f i2c
  try "usermod -aG ... $NEW_USER"  usermod -aG video,input,i2c,render,audio,wheel "$NEW_USER"
fi

# ── drop liveuser ──────────────────────────────────────────────────────────
if id liveuser &>/dev/null; then
  try "userdel -r liveuser" userdel -r liveuser
fi

# ── remove live gnupg tmpfs mount (else it hides the real keyring) ─────────
# /etc/pacman.d/gnupg itself is KEPT (built in the squashfs by customize_air-
# ootfs.sh, copied to disk by unpackfs). We just need the tmpfs unit gone.
try "drop live gnupg tmpfs mount" bash -c '
  systemctl disable etc-pacman.d-gnupg.mount 2>/dev/null || true
  rm -f /etc/systemd/system/etc-pacman.d-gnupg.mount
  rm -f /etc/systemd/system/multi-user.target.wants/etc-pacman.d-gnupg.mount
'

# ── remove live-only tty1 passwordless-root autologin (SEC-02) ──────────────
# The archiso releng baseline ships a getty@tty1 drop-in with `--autologin root`
# (no password). It is inert on the live ISO (greetd Conflicts=getty@tty1 and
# owns vt1) but would autologin root on the default console the instant greetd
# is disabled/removed on an installed system. unpackfs.conf already excludes the
# drop-in dir from the target; this is defense-in-depth in case that exclude
# ever regresses. Plain getty (password login) takes over tty1.
try "drop live tty1 root autologin" bash -c '
  rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
  rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
'

# ── remove live-only tty2 passwordless-root rescue autologin (SEC-01) ───────
# The getty@tty2 drop-in gives `--autologin root` with no password — a live-ISO
# rescue console ONLY. unpackfs.conf already excludes the drop-in dir from the
# target; this is defense-in-depth in case that exclude ever regresses, so the
# installed system never ships passwordless root on Ctrl+Alt+F2. Plain getty
# (password login) takes over tty2.
try "drop live tty2 root autologin" bash -c '
  rm -f /etc/systemd/system/getty@tty2.service.d/autologin.conf
  rmdir /etc/systemd/system/getty@tty2.service.d 2>/dev/null || true
'

# ── remove Calamares + chroot build deps from the installed system ────────
# The installer package set is DATA-DRIVEN from installer.list: 40-packages.sh
# stages the same names we baked as installer-only into the squashfs at
# /usr/share/illogical-impulse/installer-purge.list, so this purge can never
# drift from what was baked (a third installer.list entry can't leak onto the
# target). The hardcoded `calamares kpmcore` is only a fail-safe default if the
# staged list is missing. We remove the list after consuming it.
T "removing Calamares + ISO build deps from installed system"
IPURGE_LIST=/usr/share/illogical-impulse/installer-purge.list
if [[ -s "$IPURGE_LIST" ]]; then
  mapfile -t _installer_pkgs < <(grep -Ev '^\s*(#|$)' "$IPURGE_LIST")
else
  _installer_pkgs=(calamares kpmcore)
fi
if (( ${#_installer_pkgs[@]} > 0 )); then
  pacman -Rns --noconfirm "${_installer_pkgs[@]}" 2>/dev/null \
    || pacman -Rdd --noconfirm "${_installer_pkgs[@]}" 2>/dev/null || true
fi
rm -f "$IPURGE_LIST"
rm -rf /etc/calamares /usr/share/calamares
rm -f /usr/share/applications/{calamares,calamares-launch-oem,install-illogical-impulse}.desktop \
      /usr/local/share/applications/calamares.desktop \
      /usr/local/bin/ii-launch-installer
# NOTE: git + base-devel are deliberately NOT purged — they're part of the
# baked dev tooling and paru/iictl-update need them at runtime.
pacman -Rns --noconfirm meson meson-python ninja 2>/dev/null || true
pacman -Rns --noconfirm grub syslinux 2>/dev/null || true

# ── NVIDIA: detect hardware, install the right driver offline ─────────────
# The stash (built by chroot.sh, copied here by unpackfs) is a tiny pacman
# repo with both driver variants + dep closure. Classification is by PCI
# device id — supported-gpus.json no longer ships anywhere, and NVIDIA ids
# grow monotonically per generation:
#   >= 0x1E00          Turing+ (TU102 and newer)  → nvidia-open-dkms ("open")
#   0x1300 .. 0x1DFF   Maxwell/Pascal/Volta       → nvidia-580xx     ("legacy")
#   <  0x1300          Kepler and older           → nouveau          ("nouveau")
# The id→variant ranges + the "legacy wins on a mixed machine" fold live in the
# pure ii_nvidia_fold/ii_nvidia_classify helpers (nvidia-classify.sh, sourced at
# the top) so they are unit-testable; see validate.sh's HW-01 boundary table.
# 'nouveau' here means "install nothing" (the prior NV_VARIANT=none).
NVSTASH=/usr/share/illogical-impulse/nvidia
if [[ -f "$NVSTASH/ii-nvidia.db.tar.gz" ]]; then
  mapfile -t NV_IDS < <(
    for d in /sys/bus/pci/devices/*; do
      [[ "$(cat "$d/vendor" 2>/dev/null)" == "0x10de" ]] || continue
      case "$(cat "$d/class" 2>/dev/null)" in 0x03*) cat "$d/device" ;; esac
    done)
  if (( ${#NV_IDS[@]} > 0 )); then
    T "NVIDIA GPU(s) detected: ${NV_IDS[*]}"
    if type ii_nvidia_fold &>/dev/null; then
      NV_VARIANT="$(ii_nvidia_fold "${NV_IDS[@]}")"
    else
      # nvidia-classify.sh absent (dev checkout) — inline the identical fold.
      NV_VARIANT=nouveau
      for id in "${NV_IDS[@]}"; do
        dec=$(( 16#${id#0x} ))
        if   (( dec >= 16#1300 && dec < 16#1E00 )); then NV_VARIANT=legacy; break
        elif (( dec >= 16#1E00 )); then NV_VARIANT=open
        fi
      done
    fi
    if [[ "$NV_VARIANT" != nouveau ]]; then
      cat > /etc/pacman-ii-nvidia.conf <<NVCONF
[options]
Architecture = auto
SigLevel = Optional TrustAll

[ii-nvidia]
Server = file://$NVSTASH
NVCONF
      try "sync nvidia stash repo" pacman --config /etc/pacman-ii-nvidia.conf -Sy --noconfirm
      if [[ "$NV_VARIANT" == open ]]; then
        try "install nvidia-open-dkms" pacman --config /etc/pacman-ii-nvidia.conf \
          -S --noconfirm nvidia-open-dkms nvidia-utils linux-headers linux-lts-headers
      else
        try "install nvidia-580xx-dkms (pre-Turing GPU)" pacman --config /etc/pacman-ii-nvidia.conf \
          -S --noconfirm nvidia-580xx-dkms nvidia-580xx-utils linux-headers linux-lts-headers
      fi
    else
      T "only pre-Maxwell NVIDIA found — staying on nouveau"
    fi
  else
    T "no NVIDIA hardware — skipping driver install"
  fi
  rm -f /etc/pacman-ii-nvidia.conf /var/lib/pacman/sync/ii-nvidia.db*
  rm -rf "$NVSTASH"
fi

# ── docker (baked): socket activation + group membership ──────────────────
# The docker group add is install-time distro setup, not vanilla upstream — route
# it through the same ii_group_add mutator (tagged src=install) so the row is
# ledgered identically to the baseline groups above and `iictl revert-all --deep`
# peels it (a plain revert leaves it). Mutate as root, land the ledger in the new
# user's state dir, then chown — mirroring the baseline-groups block.
if [[ -e /usr/lib/systemd/system/docker.socket ]]; then
  install -d /etc/systemd/system/sockets.target.wants
  ln -sf /usr/lib/systemd/system/docker.socket /etc/systemd/system/sockets.target.wants/docker.socket
  if [[ -n "$NEW_USER" ]] && getent group docker >/dev/null 2>&1; then
    if type ii_group_add &>/dev/null; then
      H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
      [[ -n "$H" && -d "$H" ]] \
        && try "docker group ($NEW_USER)" ii_group_add_for "$H" "$NEW_USER" docker
    else
      try "docker group" usermod -aG docker "$NEW_USER"   # dev-checkout fallback
    fi
  fi
fi

# ── cups (baked): socket activation for printing ──────────────────────────
if [[ -e /usr/lib/systemd/system/cups.socket ]]; then
  install -d /etc/systemd/system/sockets.target.wants
  ln -sf /usr/lib/systemd/system/cups.socket /etc/systemd/system/sockets.target.wants/cups.socket
fi
if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  if [[ -n "$H" && -d "$H" ]]; then
    rm -f "$H/Desktop/Install"*.desktop \
          "$H/.local/share/applications/"{calamares,install-illogical-impulse}.desktop 2>/dev/null
  fi
fi

# ── greetd: installed template substituted with new user ──────────────────
T "/etc/greetd/config.toml"
TPL=/etc/greetd/config.toml.installed.template
if [[ -f "$TPL" && -n "$NEW_USER" ]]; then
  [[ -f /etc/greetd/config.toml ]] && cp /etc/greetd/config.toml /etc/greetd/config.toml.bak
  sed "s|@NEW_USER@|$NEW_USER|g" "$TPL" > /etc/greetd/config.toml
  T "  wrote /etc/greetd/config.toml (autologin: $NEW_USER)"
fi

# ── kernel module + ydotool user service ──────────────────────────────────
mkdir -p /etc/modules-load.d
echo 'i2c-dev' > /etc/modules-load.d/i2c-dev.conf
[[ -f /usr/lib/systemd/system/ydotool.service && ! -e /usr/lib/systemd/user/ydotool.service ]] \
  && ln -sf /usr/lib/systemd/system/ydotool.service /usr/lib/systemd/user/ydotool.service
[[ -n "$NEW_USER" ]] && type ii_enable_linger &>/dev/null \
  && try "linger $NEW_USER" ii_enable_linger "$NEW_USER"

# ── system services (declarative + needed-on-install) ─────────────────────
# The static overlay symlinks in /etc/systemd/system/*.wants/ get copied by
# unpackfs and survive — we just need to make sure greetd is wired as the
# display-manager and a few optional packages get enabled if installed.
T "system services"
install -d /etc/systemd/system/graphical.target.wants /etc/systemd/system/multi-user.target.wants
if [[ -e /usr/lib/systemd/system/greetd.service ]]; then
  ln -sf /usr/lib/systemd/system/greetd.service /etc/systemd/system/graphical.target.wants/greetd.service
  ln -sf /usr/lib/systemd/system/greetd.service /etc/systemd/system/display-manager.service
fi
for svc in NetworkManager bluetooth sshd; do
  [[ -e /usr/lib/systemd/system/$svc.service ]] \
    && ln -sf /usr/lib/systemd/system/$svc.service /etc/systemd/system/multi-user.target.wants/$svc.service
done
ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target

# ── dconf + KDE defaults ──────────────────────────────────────────────────
T "dconf defaults (font + dark mode)"
mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
cat > /etc/dconf/profile/user <<'EOF'
user-db:user
system-db:local
EOF
cat > /etc/dconf/db/local.d/00-defaults <<'EOF'
[org/gnome/desktop/interface]
font-name='Google Sans Flex Medium 11 @opsz=11,wght=500'
color-scheme='prefer-dark'
EOF
try "dconf update" dconf update

if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  if [[ -n "$H" && -d "$H" ]] && type ii_systemd_running &>/dev/null; then
    if ii_systemd_running && command -v kwriteconfig6 &>/dev/null; then
      try "kdeglobals Darkly" runuser -u "$NEW_USER" -- env HOME="$H" kwriteconfig6 \
        --file kdeglobals --group KDE --key widgetStyle Darkly
    else
      try "kdeglobals Darkly (offline)" ii_set_kde_widget_style "$NEW_USER" "$H" Darkly
    fi
  fi
fi

# ── skel fallback (if Calamares useradd -m skipped skel — e.g. reused /home) ──
if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  if [[ -n "$H" && -d "$H" ]] && [[ ! -d "$H/.config/quickshell/ii" ]]; then
    T "/etc/skel was not copied → rsync-ing $H from /etc/skel"
    try "skel fallback" bash -c "rsync -a /etc/skel/ '$H/' && chown -R '$NEW_USER:$NEW_USER' '$H'"
  fi
fi

# ── Quickshell venv at the new user's real $HOME (offline wheelhouse) ────
# venvs bake absolute paths into their activate scripts, so this can't live in
# /etc/skel. Color generation, kitty theming, etc. are NOT pre-rendered: on
# first login `iictl welcome --auto` runs switchwall.sh in a real Hyprland
# session (it replaces upstream's FirstRunExperience — suppressed just below).
# Drop to the user with runuser, NOT sudo -u: this whole script runs in the
# Calamares chroot (no /dev/pts), where sudo's default use_pty dies with
# "unable to allocate pty" — silently skipping the venv build (INST-05). All
# `runuser -u "$NEW_USER" --` drops below carry the user env explicitly.
if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  VENV="$H/.local/state/quickshell/.venv"
  if [[ -n "$H" && -d "$H" && -x /usr/local/bin/ii-ensure-venv ]]; then
    try "ii-ensure-venv $NEW_USER" runuser -u "$NEW_USER" -- env \
      HOME="$H" XDG_CONFIG_HOME="$H/.config" \
      XDG_STATE_HOME="$H/.local/state" XDG_CACHE_HOME="$H/.cache" \
      UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-/usr/share/uv/python}" \
      /usr/local/bin/ii-ensure-venv
  fi
  if [[ -x "$VENV/bin/python" ]]; then
    runuser -u "$NEW_USER" -- env HOME="$H" "$VENV/bin/python" -c 'import materialyoucolor, PIL' 2>/dev/null \
      && T "  ok    Quickshell venv (Pillow + materialyoucolor)" \
      || T "  CRIT  Quickshell venv missing Pillow/materialyoucolor — first-boot color gen will fail"
  else
    T "  CRIT  no Quickshell venv at $VENV"
  fi
fi

# ── deactivate upstream's first-run welcome; defer to ours ─────────────────
# Upstream's FirstRunExperience.qml shows its own welcome app (and runs
# switchwall.sh) on the first login where ~/.local/state/quickshell/user/
# first_run.txt is absent. The distro pre-seeds that marker for the INSTALLED
# user via overlay/skel-distro/.local/state → /etc/skel (useradd -m copies it
# here), so it normally already exists. (The liveuser is deliberately NOT seeded
# — it keeps upstream's first-run for the wallpaper/colour bootstrap; see
# 30-skel.sh.) We keep a fail-safe seed for the rare case it is missing, then
# record it in the NEW USER's ledger (kind 'file' so revert-all's path inverse
# removes it) — so `iictl revert-all` deletes the marker and the vanilla upstream
# welcome returns on the next login. OUR card shows instead (iictl welcome
# --auto, launched from skel custom/execs.lua), replicating the wallpaper/colour
# bootstrap itself. Additive + reversible.
if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6 || true)
  if [[ -n "$H" && -d "$H" ]]; then
    FRUN="$H/.local/state/quickshell/user/first_run.txt"
    if [[ ! -e "$FRUN" ]]; then          # fail-safe: skel-distro normally seeds it
      install -d -o "$NEW_USER" -g "$NEW_USER" "$(dirname "$FRUN")"
      printf "This file is just here to confirm you've been greeted :>\n" > "$FRUN"
      chown "$NEW_USER:$NEW_USER" "$FRUN"
    fi
    T "  first_run.txt present → upstream welcome suppressed; ours shows on first login"
    # Record regardless of who wrote it (skel or the fail-safe above) so the
    # skel-provided copy is reversible too — the old `! -e` guard skipped this
    # once skel started seeding the file.
    if [[ -e "$FRUN" && -r /usr/local/lib/ii/ledger.sh ]]; then
      try "ledger: first-run welcome override" runuser -u "$NEW_USER" -- env \
        HOME="$H" XDG_STATE_HOME="$H/.local/state" \
        bash -c 'source /usr/local/lib/ii/ledger.sh && ledger_record file first-run-welcome "" "$(ledger_escape_path "$HOME/.local/state/quickshell/user/first_run.txt")" "rm to restore upstream first-run welcome"'
    fi
    # ── ledger: welcome exec-hook fence (REV-01) ──────────────────────────
    # The distro welcome hook is a sentinel-fenced block named `welcome` in the
    # upstream-sanctioned custom/execs.lua slot, shipped STATICALLY via
    # overlay/skel-distro → /etc/skel → useradd -m. Arriving as a static skel
    # file, it never passes through mutator.sh's ii_lua_block_write, so no
    # `lua-block` ledger row is created and `iictl revert-all` cannot strip it —
    # the distro exec hook would survive a full revert (BLUEPRINT cites this exact
    # block as THE canonical revert-strippable fence, so that doc was false until
    # now). Record the row here, AS the new user so it lands in their state dir,
    # exactly as ii_lua_block_write would (kind=lua-block, target+owned=the file,
    # restore_hint=the block name `welcome`); revert-all's existing lua-block
    # inverse (ii_lua_block_remove) then strips precisely our fence, leaving
    # upstream's empty execs.lua stub and any user lines intact. Default scope —
    # the matched pair of the first_run.txt override above: a plain `iictl
    # revert-all` restores the vanilla upstream welcome (marker removed + our exec
    # hook stripped). Idempotent + reversible. The `welcome` token must equal the
    # block name in overlay/skel-distro/.config/hypr/custom/execs.lua.
    EXECS="$H/.config/hypr/custom/execs.lua"
    if [[ -r "$EXECS" && -r /usr/local/lib/ii/ledger.sh ]] \
       && grep -qxF -- '-- >>> illogical-impulse welcome' "$EXECS"; then
      try "ledger: welcome exec-hook fence" runuser -u "$NEW_USER" -- env \
        HOME="$H" XDG_STATE_HOME="$H/.local/state" \
        bash -c 'source /usr/local/lib/ii/ledger.sh && ledger_record lua-block "$HOME/.config/hypr/custom/execs.lua" "" "$(ledger_escape_path "$HOME/.config/hypr/custom/execs.lua")" welcome'
    fi
  fi
fi

# ── refresh systemd-boot loader after fstab/cmdline tweaks ────────────────
if [[ -x /usr/bin/bootctl && -d /boot/efi && -x /usr/local/bin/ii-finish-systemd-boot ]]; then
  try "ii-finish-systemd-boot" /usr/local/bin/ii-finish-systemd-boot
fi

T ""
T "==== done — $(date -u +%FT%TZ) ===="
exit 0

#!/usr/bin/env bash
# Calamares shellprocess@copy-kernel hook. Runs INSIDE the installed chroot
# before the bootloader module. Sets up /boot for the installed system.

set -euo pipefail
LOG=/var/log/ii-prepare-bootloader.log
mkdir -p "$(dirname "$LOG")"
exec 3>&1; exec > >(tee -a "$LOG" >&3); exec 2>&1
log() { echo "[ii-prepare-bootloader] $*"; }
die() { log "FATAL: $*"; exit 1; }
# set -e kills silently otherwise — a build was lost to an invisible death.
trap 'log "FATAL: unexpected error at line $LINENO: $BASH_COMMAND"' ERR

STASH=/usr/share/illogical-impulse/boot-stash

log "uname: $(uname -a)"

# ── sanity ─────────────────────────────────────────────────────────────────
command -v mkinitcpio >/dev/null || die "mkinitcpio not installed"
shopt -s nullglob; kver_dirs=( /usr/lib/modules/*/ ); shopt -u nullglob
(( ${#kver_dirs[@]} > 0 )) || die "no kernels in /usr/lib/modules/"
for d in "${kver_dirs[@]}"; do
  [[ -f "${d}vmlinuz" ]] || die "${d}vmlinuz missing"
  [[ -f "${d}pkgbase" ]] || die "${d}pkgbase missing"
done
install -d -m 0755 /boot

# ── purge live archiso mkinitcpio leftovers ────────────────────────────────
rm -f /etc/mkinitcpio.conf.d/archiso*.conf

# ── /etc/mkinitcpio.conf — deterministic universal config ──────────────────
# No autodetect → installed initramfs ships every driver. Bulletproof when
# the install hardware differs from the live medium. Tune later by hand.
HOOKS=(base udev microcode modconf kms keyboard keymap consolefont block)
[[ -f /etc/crypttab    ]] && grep -qvE '^\s*(#|$)' /etc/crypttab    && HOOKS+=(encrypt)
grep -qE '^\S+\s+none\s+swap' /etc/fstab 2>/dev/null              && HOOKS+=(resume)
HOOKS+=(filesystems fsck)

cat > /etc/mkinitcpio.conf <<MKI
# Written by ii-prepare-bootloader. Universal (no autodetect) ships every
# driver, safe across hardware. Edit + \`mkinitcpio -P\` to slim down later.
MODULES=()
BINARIES=()
FILES=()
HOOKS=(${HOOKS[*]})
COMPRESSION="zstd"
COMPRESSION_OPTIONS=()
MKI
log "wrote /etc/mkinitcpio.conf (hooks: ${HOOKS[*]})"

# ── resume helpers (pure where possible — table-tested by validate.sh) ──────
#
# Classify an fstab swap source (field 1). A swap *partition* is a block-device
# reference (UUID=/LABEL=/PARTUUID=/PARTLABEL= or a /dev/ node); a swap *file* is
# an ordinary path under the root filesystem (e.g. /swapfile). The kernel can
# resume directly from a partition (resume=<dev>), but a swapfile needs
# resume=<the block device holding the fs> + resume_offset=<physical block>.
# Returns: "partition" or "file". Pure: depends only on its argument.
ii_classify_swap_source() {
  local src="$1"
  case "$src" in
    UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*|/dev/*) echo "partition" ;;
    /*)                                           echo "file" ;;
    *)                                            echo "partition" ;;  # opaque → treat as device spec
  esac
}

# Build the `cryptdevice=` token for one crypttab line. The mapping target is
# field 1, the backing source field 2. Only a bare `UUID=<uuid>` source becomes
# `cryptdevice=UUID=<uuid>:<name>`; any other spec (a /dev node, LABEL=, …) is
# passed through verbatim as `cryptdevice=<source>:<name>` — never wrapped in a
# spurious second `UUID=` (the old bug produced `cryptdevice=UUID=/dev/sda2:…`).
# Pure: depends only on its two arguments. Echoes nothing if either is empty.
ii_cryptdevice_token() {
  local name="$1" source="$2"
  [[ -n "$name" && -n "$source" ]] || return 0
  # The source is emitted VERBATIM (UUID=… stays UUID=…, a /dev node or LABEL=
  # stays as written). The old code did `${source#UUID=}` and re-prefixed UUID=
  # unconditionally → `cryptdevice=UUID=/dev/sda2:name` for a non-UUID source.
  echo "cryptdevice=$source:$name"
}

# Physical byte offset of the first extent of a swapfile, divided by the page
# size → the value the kernel wants in resume_offset=. ext4/xfs via filefrag,
# btrfs via `btrfs inspect-internal map-swapfile` (filefrag's logical extents
# are meaningless on btrfs). Echoes the offset on success, nothing on failure.
ii_swapfile_resume_offset() {
  local file="$1" fstype="$2" off=""
  [[ -f "$file" ]] || return 0
  if [[ "$fstype" == btrfs ]]; then
    # modern btrfs-progs prints "resume_offset NNN" (in pages already)
    if command -v btrfs >/dev/null; then
      off=$(btrfs inspect-internal map-swapfile -r "$file" 2>/dev/null | awk '{print $1}')
    fi
  else
    # filefrag -v: physical offset is the "physical_offset" column of extent 0,
    # in filesystem blocks; multiply by the block size, divide by the page size.
    if command -v filefrag >/dev/null; then
      local phys_blk blk_sz pg_sz
      phys_blk=$(filefrag -v "$file" 2>/dev/null \
                 | awk '/^[[:space:]]*0:/ { gsub(/\.\./,"",$4); print $4+0; exit }')
      blk_sz=$(filefrag -v "$file" 2>/dev/null \
               | sed -n 's/.*of \([0-9]\+\)-byte blocks.*/\1/p' | head -1)
      [[ -z "$blk_sz" ]] && blk_sz=$(stat -f -c %S "$file" 2>/dev/null || echo 4096)
      pg_sz=$(getconf PAGE_SIZE 2>/dev/null || echo 4096)
      [[ -n "$phys_blk" && -n "$blk_sz" && "$pg_sz" -gt 0 ]] \
        && off=$(( phys_blk * blk_sz / pg_sz ))
    fi
  fi
  [[ -n "$off" ]] && echo "$off"
}

# ── kernel cmdline (read by systemd-boot via kernel-install) ───────────────
write_cmdline() {
  local -a parts=(loglevel=4 rootwait rw)
  local root_line root_dev root_fstype
  root_line=$(grep -E '^\S+\s+/\s+' /etc/fstab 2>/dev/null | head -1 || true)
  if [[ -n "$root_line" ]]; then
    root_dev=$(awk '{print $1}' <<< "$root_line")
    root_fstype=$(awk '{print $3}' <<< "$root_line")
    parts+=("root=$root_dev")
    local opts subvol
    opts=$(awk '{print $4}' <<< "$root_line")
    subvol=$(grep -oE 'subvol=[^,]+' <<< "$opts" | head -1 | cut -d= -f2 || true)
    [[ "$root_fstype" == btrfs && -n "$subvol" ]] \
      && parts+=("rootflags=subvol=$subvol")
  fi
  if [[ -f /etc/crypttab ]]; then
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
      local m s tok
      m=$(awk '{print $1}' <<< "$line")
      s=$(awk '{print $2}' <<< "$line")
      tok=$(ii_cryptdevice_token "$m" "$s")
      [[ -n "$tok" ]] && parts+=("$tok")
    done < /etc/crypttab
  fi
  local swap swap_src
  swap=$(grep -E '^\S+\s+none\s+swap' /etc/fstab 2>/dev/null | head -1 || true)
  if [[ -n "$swap" ]]; then
    swap_src=$(awk '{print $1}' <<< "$swap")
    if [[ "$(ii_classify_swap_source "$swap_src")" == file ]]; then
      # Swapfile: resume from the BLOCK DEVICE holding the root fs + an offset.
      # Never emit the swapfile PATH as resume= — the kernel can't resume from it.
      local off
      off=$(ii_swapfile_resume_offset "$swap_src" "${root_fstype:-}")
      if [[ -n "$root_dev" && -n "$off" ]]; then
        parts+=("resume=$root_dev" "resume_offset=$off")
        log "swapfile resume: resume=$root_dev resume_offset=$off (file $swap_src)"
      else
        log "WARN: swapfile $swap_src — could not compute resume_offset; hibernation disabled"
      fi
    else
      parts+=("resume=$swap_src")
      log "swap partition resume: resume=$swap_src"
    fi
  fi
  mkdir -p /etc/kernel/cmdline.d
  echo "${parts[*]}" > /etc/kernel/cmdline.d/illogical-impulse.conf
}
write_cmdline
log "wrote /etc/kernel/cmdline.d/illogical-impulse.conf"

# ── restore CPU microcode from the chroot stash ────────────────────────────
# mkarchiso wipes /boot/* from the airootfs after customize_airootfs.sh
# runs; without this restore the installed system has no microcode loaded.
for f in intel-ucode.img amd-ucode.img; do
  [[ -f "$STASH/$f" ]] && install -m 0644 "$STASH/$f" "/boot/$f" \
                       && log "restored /boot/$f"
done

# ── copy each kernel + per-kernel preset (default + fallback) ──────────────
# Upstream mkinitcpio ships PRESETS=('default') with fallback commented out.
# We always want both — fallback is the rescue image after a broken upgrade.
install -d -m 0755 /etc/mkinitcpio.d
copied=0
for d in "${kver_dirs[@]}"; do
  pkgbase=$(< "${d}pkgbase"); pkgbase="${pkgbase//[$'\t\r\n ']/}"
  [[ -n "$pkgbase" ]] || die "empty pkgbase in $d"
  install -m 0644 "${d}vmlinuz" "/boot/vmlinuz-$pkgbase"
  cat > "/etc/mkinitcpio.d/$pkgbase.preset" <<PRE
# Written by ii-prepare-bootloader.
ALL_kver="/boot/vmlinuz-$pkgbase"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-$pkgbase.img"
fallback_image="/boot/initramfs-$pkgbase-fallback.img"
fallback_options="-S autodetect"
PRE
  log "kernel $pkgbase: vmlinuz + preset"
  # NOT ((copied++)): post-increment of 0 returns 1 and set -e kills the
  # script silently — exactly how the two-kernel install died.
  copied=$((copied + 1))
done
(( copied > 0 )) || die "no kernels copied"

# ── build initramfs images ─────────────────────────────────────────────────
mkinitcpio -P || { ls -la /boot >&2; die "mkinitcpio -P failed"; }

# ── state file for ii-verify ───────────────────────────────────────────────
expected=()
for d in "${kver_dirs[@]}"; do
  pkgbase=$(< "${d}pkgbase"); pkgbase="${pkgbase//[$'\t\r\n ']/}"
  expected+=("/boot/vmlinuz-$pkgbase"
             "/boot/initramfs-$pkgbase.img"
             "/boot/initramfs-$pkgbase-fallback.img")
done
{
  echo '{'
  echo "  \"generated\": \"$(date -u +%FT%TZ)\","
  echo "  \"kernels_copied\": $copied,"
  echo '  "expected_paths": ['
  first=1
  for p in "${expected[@]}"; do
    (( first )) && first=0 || echo ','
    printf '    "%s"' "$p"
  done
  echo
  echo '  ]'
  echo '}'
} > /boot/.ii-boot-state.json

log "done — /boot:"
ls -la /boot | sed 's/^/[ii-prepare-bootloader]   /'

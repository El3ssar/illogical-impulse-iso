#!/usr/bin/env bash
# Calamares shellprocess@verify-install hook. Final sanity gate; auto-repairs
# common failures where it can. If anything is still broken at the end, exit
# non-zero — Calamares aborts the install (better than handing the user a
# brick).
#
# On all-pass, this also wipes ISO-only helpers from /usr/local/bin so the
# installed system carries no ISO-builder scripts beyond what's strictly needed.
# The lib purge is by NAMED FILE, never `rm -rf /usr/local/lib/ii`: that dir is
# a survive-path for the iictl framework — iictl.d/ (drop-in subcommands) and
# ledger.sh (the reversibility manifest) must persist onto the installed system
# (PROPOSAL §4 Pillar 0). Only ISO-only helpers (session-offline.sh, the wheels
# dir) are removed; the dir itself is rmdir'd only when it is left empty.

set -u
LOG=/var/log/ii-verify.log
mkdir -p "$(dirname "$LOG")"
[[ -f /usr/local/lib/ii/session-offline.sh ]] \
  && { source /usr/local/lib/ii/session-offline.sh; ii_tee_log "$LOG"; } \
  || { exec 3>&1; exec > >(tee -a "$LOG" >&3); exec 2>&1; }

T() { echo "[ii-verify] $*"; }
PASS=() FAIL=() FIX=()
pass()   { T "  ok    $*"; PASS+=("$*"); }
fail()   { T "  FAIL  $*"; FAIL+=("$*"); }
fix()    { T "  fix   $*"; FIX+=("$*"); }

T "==== $(date -u +%FT%TZ) ===="

# ── /boot artefacts (EVERY installed kernel, not just `linux`) ───────────────
# goodies.list ships linux-lts beside linux, and ii-prepare-bootloader builds a
# default+fallback initramfs for EVERY pkgbase in /usr/lib/modules/*/ (writing
# each expected path into /boot/.ii-boot-state.json). A hardcoded `linux` triple
# here let a broken linux-lts initramfs slip through — the LTS rescue entry then
# boots to a broken image, defeating the whole point of always building both
# presets. So derive the kernel set the SAME way the bootloader hook did:
# prefer .ii-boot-state.json's expected_paths (authoritative — it is exactly
# what was built), else enumerate /usr/lib/modules/*/pkgbase (the bootloader
# hook's own source). Then size-check default+fallback for EACH kernel.
MIN_VMLINUZ=$((1*1024*1024))
MIN_INITRAMFS=$((5*1024*1024))

BOOT_STATE=/boot/.ii-boot-state.json
kernels=()   # pkgbase list (e.g. linux linux-lts)

# (1) authoritative source: the per-kernel expected_paths the bootloader hook
# wrote. Pull each vmlinuz-<pkgbase> and recover the pkgbase from it; this also
# implicitly validates the JSON carries real paths, not just that it exists.
if [[ -f "$BOOT_STATE" ]]; then
  pass "boot-state.json present"
  while IFS= read -r kb; do
    [[ -n "$kb" ]] && kernels+=("$kb")
  done < <(grep -oE '/boot/vmlinuz-[A-Za-z0-9._+-]+' "$BOOT_STATE" \
             | sed 's|^/boot/vmlinuz-||' | sort -u)
  (( ${#kernels[@]} > 0 )) \
    && pass "boot-state.json expected_paths name ${#kernels[@]} kernel(s): ${kernels[*]}" \
    || fail "boot-state.json has no vmlinuz-* expected_paths — bootloader hook wrote a malformed state file"
else
  fail "boot-state.json missing"
fi

# (2) fallback source (or cross-check): enumerate installed kernels exactly as
# ii-prepare-bootloader does, via /usr/lib/modules/*/pkgbase. Used when the
# state file is missing/empty so a verify still covers every kernel.
if (( ${#kernels[@]} == 0 )); then
  shopt -s nullglob
  for d in /usr/lib/modules/*/; do
    [[ -f "${d}pkgbase" ]] || continue
    kb=$(< "${d}pkgbase"); kb="${kb//[$'\t\r\n ']/}"
    [[ -n "$kb" ]] && kernels+=("$kb")
  done
  shopt -u nullglob
  # de-dupe (a pkgbase can own multiple module dirs)
  if (( ${#kernels[@]} > 0 )); then
    mapfile -t kernels < <(printf '%s\n' "${kernels[@]}" | sort -u)
    pass "enumerated ${#kernels[@]} kernel(s) from /usr/lib/modules/*/pkgbase: ${kernels[*]}"
  fi
fi
(( ${#kernels[@]} > 0 )) || fail "no installed kernels found (neither boot-state.json nor /usr/lib/modules/*/pkgbase)"

# Per-kernel repair + size-check. Repair a missing fallback (the rescue-kernel
# case) by fixing that kernel's preset and rebuilding ITS images, then size-check
# vmlinuz + default + fallback for each.
for kb in "${kernels[@]}"; do
  if [[ -f "/boot/initramfs-$kb.img" && ! -f "/boot/initramfs-$kb-fallback.img" ]]; then
    P="/etc/mkinitcpio.d/$kb.preset"
    if [[ -f "$P" ]] && ! grep -qE "^PRESETS=\(.*\bfallback\b.*\)" "$P"; then
      sed -i "s|^PRESETS=.*$|PRESETS=('default' 'fallback')|" "$P"
      grep -q '^fallback_image=' "$P" || cat >> "$P" <<F
fallback_image="/boot/initramfs-$kb-fallback.img"
fallback_options="-S autodetect"
F
      fix "patched $P to enable fallback preset"
    fi
    mkinitcpio -p "$kb" 2>&1 | sed 's/^/[ii-verify]     /' \
      && fix "built initramfs-$kb-fallback.img"
  fi
  for spec in "vmlinuz-$kb:$MIN_VMLINUZ" \
              "initramfs-$kb.img:$MIN_INITRAMFS" \
              "initramfs-$kb-fallback.img:$MIN_INITRAMFS"; do
    f="${spec%:*}"; min="${spec##*:}"; p="/boot/$f"
    if [[ ! -e "$p" ]]; then fail "$p missing"; continue; fi
    sz=$(stat -c %s "$p" 2>/dev/null || echo 0)
    (( sz >= min )) && pass "$p ($sz B)" || fail "$p too small ($sz B, need ≥ $min)"
  done
done

# ── archiso hooks must NOT survive on the installed system ─────────────────
rebuild_initramfs=false
if compgen -G '/etc/mkinitcpio.conf.d/archiso*.conf' >/dev/null; then
  fix "removing live-only /etc/mkinitcpio.conf.d/archiso*.conf"
  rm -f /etc/mkinitcpio.conf.d/archiso*.conf
  rebuild_initramfs=true
else
  pass "no archiso mkinitcpio drop-ins"
fi
# Scan EVERY kernel's preset + default image for archiso leftovers, not just
# `linux` — a stray archiso reference under any kernel must trigger the rebuild.
# The rewrite is per-kernel; the rebuild below delegates to ii-prepare-bootloader
# (which re-authors all presets correctly), so this only needs to defuse the
# archiso reference so that re-run is taken.
for kb in "${kernels[@]:-linux}"; do
  P="/etc/mkinitcpio.d/$kb.preset"
  if [[ -f "$P" ]] && grep -qE 'archiso_config|PRESETS=.*archiso' "$P"; then
    fail "$P references archiso"
    cat > "$P" <<EOF
ALL_kver="/boot/vmlinuz-$kb"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-$kb.img"
fallback_image="/boot/initramfs-$kb-fallback.img"
fallback_options="-S autodetect"
EOF
    fix "rewrote $P"
    rebuild_initramfs=true
  fi
  if [[ -f "/boot/initramfs-$kb.img" ]] && command -v lsinitcpio >/dev/null \
     && lsinitcpio "/boot/initramfs-$kb.img" 2>/dev/null | grep -q '/hooks/archiso'; then
    fail "initramfs-$kb.img contains archiso hook"
    rebuild_initramfs=true
  fi
done
if $rebuild_initramfs; then
  if [[ -x /usr/local/bin/ii-prepare-bootloader ]]; then
    /usr/local/bin/ii-prepare-bootloader 2>&1 | sed 's/^/[ii-verify]     /' \
      && fix "re-ran ii-prepare-bootloader"
    [[ -x /usr/local/bin/ii-finish-systemd-boot ]] \
      && /usr/local/bin/ii-finish-systemd-boot 2>&1 | sed 's/^/[ii-verify]     /' \
      && fix "re-ran ii-finish-systemd-boot"
  else
    mkinitcpio -P 2>&1 | sed 's/^/[ii-verify]     /' && fix "rebuilt initramfs"
  fi
fi

# ── EFI bootloader ─────────────────────────────────────────────────────────
if [[ -d /sys/firmware/efi && -d /boot/efi ]]; then
  ESP=/boot/efi
  primary=""
  [[ -f "$ESP/EFI/systemd/systemd-bootx64.efi" ]] && primary="$ESP/EFI/systemd/systemd-bootx64.efi"
  if [[ -z "$primary" ]]; then
    for g in "$ESP"/EFI/*/systemd-bootx64.efi; do
      [[ "$(dirname "$g")" == */EFI/BOOT ]] && continue
      [[ -f "$g" ]] && primary="$g" && break
    done
  fi
  [[ -n "$primary" ]] && pass "systemd-boot at $primary" || fail "systemd-bootx64.efi missing on ESP"

  fb="$ESP/EFI/BOOT/BOOTX64.EFI"
  if compgen -G "$ESP/EFI/BOOT/BOOT[Xx]64.EFI" >/dev/null; then
    pass "EFI fallback present"
  elif [[ -n "$primary" ]]; then
    install -d -m 0755 "$ESP/EFI/BOOT"
    cp -f "$primary" "$fb" && fix "wrote $fb from $primary" || fail "cp → $fb failed"
  else
    fail "$fb missing AND no systemd-boot binary to copy from"
  fi

  shopt -s nullglob
  count=0
  for entry in "$ESP"/loader/entries/*.conf "$ESP"/EFI/*/loader/entries/*.conf; do
    count=$((count + 1))
    grep -qE '^(linux|efi)' "$entry" && grep -q '^options .*root=' "$entry" \
      && pass "loader entry $(basename "$entry") ok" \
      || fail "loader entry $(basename "$entry") missing linux/efi or root="
  done
  shopt -u nullglob
  (( count > 0 )) || fail "no loader entries"
  [[ -s /etc/kernel/cmdline.d/illogical-impulse.conf ]] \
    && pass "cmdline drop-in present" || fail "cmdline drop-in missing"
else
  T "non-UEFI or no /boot/efi — skipping EFI checks"
fi

# ── fstab + new user + greetd ──────────────────────────────────────────────
grep -qE '^\s*(UUID|PARTUUID)=.+\s+/\s' /etc/fstab 2>/dev/null \
  && pass "/etc/fstab has root entry" || fail "/etc/fstab has no root entry"

NEW_USER=$(getent passwd | awk -F: '$3>=1000 && $3<65534 && $1!="liveuser" && $1!="nobody" {print $1; exit}')
[[ -n "$NEW_USER" ]] && pass "new user: $NEW_USER" || fail "no non-system user (Calamares users module failed)"

if [[ -f /etc/greetd/config.toml ]]; then
  if [[ -n "$NEW_USER" ]] && grep -q "user = \"$NEW_USER\"" /etc/greetd/config.toml; then
    pass "greetd autologin → $NEW_USER"
  elif grep -q "@NEW_USER@" /etc/greetd/config.toml; then
    fail "greetd config still has @NEW_USER@ — post-install didn't substitute"
  fi
else
  fail "/etc/greetd/config.toml missing"
fi
id liveuser &>/dev/null && fail "liveuser still exists on installed system" \
                        || pass "liveuser removed"

if [[ -n "$NEW_USER" ]]; then
  H=$(getent passwd "$NEW_USER" | cut -d: -f6)
  [[ -d /etc/skel/.config/quickshell/ii ]] && pass "/etc/skel has quickshell" \
                                           || fail "/etc/skel missing quickshell (ISO built without dotfiles)"
  [[ -d "$H/.config/quickshell/ii" ]] && pass "$NEW_USER has quickshell config" \
                                      || fail "$NEW_USER missing quickshell config (skel not copied)"
fi

# ── summary + ISO-only purge ───────────────────────────────────────────────
T ""
(( ${#FIX[@]}  > 0 )) && { T "repairs:"; for r in "${FIX[@]}";  do T "  + $r"; done; }
(( ${#FAIL[@]} > 0 )) && { T "FAIL:";    for r in "${FAIL[@]}"; do T "  - $r"; done; }
T "pass ${#PASS[@]}  fix ${#FIX[@]}  fail ${#FAIL[@]}"

if (( ${#FAIL[@]} == 0 )); then
  T "purging ISO-only helpers from /usr/local/bin"
  for b in ii-post-install ii-prepare-bootloader ii-finish-systemd-boot ii-verify \
           ii-build-wheelhouse ii-ensure-venv ii-session ii-launch-installer ii-live-welcome \
           ii-autoinstall; do
    rm -f "/usr/local/bin/$b"
  done
  # Purge ISO-only lib helpers by NAME — keep iictl.d/ and ledger.sh, which the
  # installed-system iictl framework depends on (PROPOSAL §4 Pillar 0). Never
  # blanket-rm the dir: rmdir below removes it only if nothing survives there.
  rm -f /usr/local/lib/ii/session-offline.sh
  rm -rf /usr/share/ii-python-wheels
  rmdir --ignore-fail-on-non-empty /usr/local/lib/ii 2>/dev/null || true
  T "done — installed system is clean (greetd → /usr/bin/start-hyprland directly)"
  exit 0
else
  T "FAIL — see $LOG and /var/log/ii-prepare-bootloader.log"
  exit 1
fi

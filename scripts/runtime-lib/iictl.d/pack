#!/usr/bin/env bash
#help: pack	install/remove/list curated optional packs online (official + AUR)
#spec: pack	Optional packs
# pack — the iictl pack engine (PROPOSAL §4 Pillar 1 / §7). The user-facing verb
# that installs, removes, and lists the curated optional software packs. As an
# iictl.d/ drop-in it adds members ONLINE on demand — official-repo members via
# `sudo pacman -S --needed`, AUR members via paru (presence-checked, bootstrap-
# or-error). Every install is recorded in the append-only TSV ledger (ledger.sh)
# as one kind=pack row carrying the *resolved* package set, so removal is an
# exact, OFFLINE-safe `pacman -Rns` of exactly what was added.
#
# Nothing pack-related is staged into the ISO: only the curated few-KB name-lists
# (`packages/optional/*.list`) ride in the squashfs as TEXT at $II_OPTDIR. There
# is no flat repo, no `.db.tar.gz`, no `pacman -Sw` closure. `[ii-extra]` does
# NOT survive install (PROPOSAL §3/§17), so the engine never assumes it — the
# install source is the public mirrors + AUR.
#
# Purely ADDITIVE: this is one new drop-in beside the iictl core (zero merge
# surface). Purely REVERSIBLE: `iictl pack remove <pack>` runs the pack's optional
# post-remove hook (the inverse of any side effects it added) and then removes the
# recorded package set through the shared revert engine. `iictl revert-all
# pack:<pack>` removes a pack's PACKAGES (its kind=pack row); a full `iictl
# revert-all` is the global catch-all that also sweeps any side-effect rows. No
# domain re-implements ledger replay.

set -u

# Shared header (colors, ok/bad/warn/die, _not_root, RELEASE_FILE, ledger_*) and
# the mutator library (ii_conflicts_check — the conflict gate — plus the
# ledger-recording ii_service_enable/ii_group_add/ii_lua_block_write a pack's
# post-add hook may call). Both source ledger.sh themselves; double-source is safe.
source "${II_LIB:-/usr/local/lib/ii}/iictl-common.sh"
source "${II_LIB:-/usr/local/lib/ii}/mutator.sh"

# Where the curated name-lists ride in the squashfs (overridable for the no-root
# unit test). The catalog lives under /usr/share — a sibling of the iictl
# survive-path, untouched by ii-verify's /usr/local/lib/ii purge.
II_OPTDIR="${II_OPTDIR:-/usr/share/illogical-impulse/optional}"
IICTL_D="${II_LIB:-/usr/local/lib/ii}/iictl.d"

# Privileged ops (pacman) go through sudo when we are the user; the baked
# 10-wheel-nopasswd drop-in makes that non-interactive on a real install. paru
# and makepkg must NEVER run as root, so they are invoked directly (no sudo).
_sudo() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }

# ── manifest parsing ─────────────────────────────────────────────────────────
# _pack_members <listfile> — echo the package-name members, one per line
# (blank lines, ordinary comments and #meta: lines stripped; trailing inline
# comments removed). Mirrors 40-packages.sh's manifest reader.
_pack_members() {
  local f="$1" line name
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line//[[:space:]]/}" ]] && continue   # blank
    [[ "$line" == '#'* ]] && continue              # comment OR #meta:
    name="${line%%#*}"; name="${name//[[:space:]]/}"
    [[ -n "$name" ]] && printf '%s\n' "$name"
  done < "$f"
}

# _pack_meta <listfile> <key> — echo the value of every `#meta:<key> [value]`
# line (value tokens, one meta-line per output line).
_pack_meta() {
  local f="$1" key="$2" line rest
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" == "#meta:$key" || "$line" == "#meta:$key "* ]] || continue
    rest="${line#"#meta:$key"}"
    printf '%s\n' "${rest# }"
  done < "$f"
}

# _pack_conflicts <listfile> — echo each declared #meta:conflicts package name,
# one per line (a single meta line may list several, space-separated).
_pack_conflicts() { _pack_meta "$1" conflicts | tr ' ' '\n' | grep -v '^[[:space:]]*$' || true; }

# _pack_installed <name> — true if a kind=pack ledger row exists for this pack.
_pack_installed() { [[ -n "$(ledger_query pack "pack:$1")" ]]; }

# ── JSON helpers (dependency-free — no jq; §11 Control Center will drive this) ─
_json_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
# read whitespace/newline-separated tokens from stdin → compact JSON array
_json_array() {
  local first=1 tok out='['
  while read -r tok; do
    [[ -n "$tok" ]] || continue
    (( first )) || out+=','
    out+="\"$(_json_escape "$tok")\""; first=0
  done
  out+=']'; printf '%s' "$out"
}

# ── paru bootstrap-or-error ──────────────────────────────────────────────────
# paru's ISO build is fail-soft (scripts/chroot.sh), so it may be absent. Mirror
# chroot.sh's clone-and-makepkg bootstrap rather than assuming it. Called ONLY
# when a pack actually has AUR members.
_ensure_paru() {
  command -v paru >/dev/null 2>&1 && return 0
  warn "paru not found — bootstrapping it from the AUR (needs base-devel + git + network)"
  command -v git     >/dev/null 2>&1 || die "git missing — install with: sudo pacman -S --needed git base-devel"
  command -v makepkg >/dev/null 2>&1 || die "base-devel missing — install with: sudo pacman -S --needed base-devel git"
  local tmp; tmp="$(mktemp -d)" || die "mktemp failed"
  if ( cd "$tmp" && git clone --depth=1 https://aur.archlinux.org/paru.git \
         && cd paru && makepkg -si --noconfirm ); then
    rm -rf "$tmp"
  else
    rm -rf "$tmp"
    die "paru bootstrap failed — install paru manually (or run: iictl pack ... after fixing AUR build deps), then retry"
  fi
  command -v paru >/dev/null 2>&1 || die "paru still not on PATH after bootstrap"
}

# ── optional per-pack hooks (convention; no concrete hook ships in this issue) ─
# A pack MAY ship <pack>.d/post-add (run after a successful install) and/or
# <pack>.d/post-remove (run before removal). Hooks are bash FRAGMENTS that are
# SOURCED — not executed — so they inherit the colors/ledger_*/mutator helpers
# already in scope here (ii_service_enable, ii_group_add, ii_lua_block_write …,
# each ledger-recording with its inverse) and so mkarchiso's +x mode-strip can
# never disarm them. The fragment sees PACK_NAME and PACK_LIST.
#
# REV-03: the hook body is SOURCED inside a SUBSHELL. A hook that calls die()/
# exit (or trips `set -e`) must NOT abort the engine before the kind=pack row is
# recorded — otherwise official members would stay installed with no ledger row
# (`pack remove` → "not installed", `revert-all` cannot undo them). The subshell
# contains a stray exit; the engine always survives to finish recording. This is
# safe because every reversible side effect a hook may apply (systemctl enable,
# usermod, fenced custom/*.lua writes, AND the ledger rows the mutators append)
# is file-/system-backed and so persists across the subshell boundary — only
# shell-variable state is lost, which the hook contract never exports back.
_run_hook() {
  local PACK_NAME="$1" PACK_PHASE="$2"
  local PACK_LIST="$II_OPTDIR/$PACK_NAME.list"
  local hook="$II_OPTDIR/$PACK_NAME.d/$PACK_PHASE"
  [[ -r "$hook" ]] || return 0
  echo "${C_B}>> running '$PACK_NAME' $PACK_PHASE hook${C_0}"
  # REV-04: stamp the pack tag onto every side-effect row the post-add hook
  # records through the shared mutators (service/group/chsh/lua-block). The
  # mutators copy II_PACK_TAG into the ledger row's packages column; revert-all's
  # `pack:<name>` filter then sweeps those rows WITH the pack's package row, so a
  # `iictl pack remove <name>` leaves no orphaned side-effect rows behind (they
  # used to linger forever, keyed on the unit/group/file rather than the pack).
  # Only the add phase records new side effects; the post-remove hook UNDOES them
  # (and revert-all prunes the rows), so it carries no tag.
  local II_PACK_TAG=""
  [[ "$PACK_PHASE" == post-add ]] && II_PACK_TAG="pack:$PACK_NAME"
  export II_PACK_TAG
  # Subshell-fence: a hook that exit/die's inside ( … ) kills only the subshell,
  # not the engine. Its disk/system side effects (incl. mutator ledger rows)
  # still land. shellcheck source=/dev/null
  ( source "$hook" ) || warn "'$PACK_NAME' $PACK_PHASE hook reported an error (continuing — pack already recorded)"
  unset II_PACK_TAG
}

# ── subcommands ──────────────────────────────────────────────────────────────
cmd_list() {
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local lists=()
  if [[ -d "$II_OPTDIR" ]]; then
    shopt -s nullglob; lists=("$II_OPTDIR"/*.list); shopt -u nullglob
  fi

  if (( json )); then
    local first=1 l name type
    printf '['
    for l in "${lists[@]}"; do
      name="$(basename "${l%.list}")"
      type="$(_pack_meta "$l" type | head -n1)"
      (( first )) || printf ','
      first=0
      printf '{"name":"%s","installed":%s,"type":"%s","members":%s,"conflicts":%s}' \
        "$(_json_escape "$name")" \
        "$(_pack_installed "$name" && echo true || echo false)" \
        "$(_json_escape "$type")" \
        "$(_pack_members "$l" | _json_array)" \
        "$(_pack_conflicts "$l" | _json_array)"
    done
    printf ']\n'
    return 0
  fi

  if (( ${#lists[@]} == 0 )); then
    echo "${C_B}iictl pack${C_0}: no packs available (none staged at $II_OPTDIR)"
    return 0
  fi
  echo "${C_B}available packs${C_0} ($II_OPTDIR):"
  local l name conflicts status
  for l in "${lists[@]}"; do
    name="$(basename "${l%.list}")"
    conflicts="$(_pack_conflicts "$l" | tr '\n' ' ')"; conflicts="${conflicts%% }"
    if _pack_installed "$name"; then status="${C_G}installed${C_0}"; else status="—"; fi
    printf '  %s%-16s%s %b' "$C_B" "$name" "$C_0" "$status"
    [[ -n "${conflicts// /}" ]] && printf '   (conflicts: %s)' "${conflicts% }"
    printf '\n'
  done
}

# cmd_spec — emit the iictl chooser-contract option spec for the pack domain
# (#47). ONE `list` control: current = the installed packs (kind=pack ledger
# rows), options = every available pack (the staged name-lists), apply_add =
# `pack install`, apply_remove = `pack remove`. The iictl-tui renderer reads
# this, draws it, and applies picks by running those argv back through this very
# plugin — so the pack round-trip drives the TUI with ZERO new mutation paths,
# proving the contract end-to-end on already-merged code. Dependency-free JSON
# (the existing _json_* helpers); no jq.
cmd_spec() {
  local lists=() l name
  if [[ -d "$II_OPTDIR" ]]; then
    shopt -s nullglob; lists=("$II_OPTDIR"/*.list); shopt -u nullglob
  fi
  local options='[' current='[' first_o=1 first_c=1
  for l in "${lists[@]}"; do
    name="$(basename "${l%.list}")"
    (( first_o )) || options+=','
    options+="{\"value\":\"$(_json_escape "$name")\",\"label\":\"$(_json_escape "$name")\"}"
    first_o=0
    if _pack_installed "$name"; then
      (( first_c )) || current+=','
      current+="\"$(_json_escape "$name")\""
      first_c=0
    fi
  done
  options+=']'; current+=']'
  printf '{"domain":"pack","title":"Optional packs","controls":[{"id":"packs","type":"list","label":"Installed packs","current":%s,"options":%s,"apply_add":["pack","install","%%v"],"apply_remove":["pack","remove","%%v"]}]}\n' \
    "$current" "$options"
}

cmd_install() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: iictl pack install <pack>"
  _not_root
  local listfile="$II_OPTDIR/$name.list"
  [[ -f "$listfile" ]] || die "unknown pack '$name' (see: iictl pack list)"

  if _pack_installed "$name"; then
    warn "pack '$name' is already installed (iictl pack remove $name to undo)"
    return 0
  fi

  local members=() conflicts=() official=() aur=() m
  mapfile -t members   < <(_pack_members   "$listfile")
  mapfile -t conflicts < <(_pack_conflicts "$listfile")
  (( ${#members[@]} > 0 )) || die "pack '$name' lists no members"

  # CONFLICT GATE — runs BEFORE any pacman transaction, so a conflicting pack is
  # refused with no half-applied state (the laptop power-tool mutual exclusion).
  if (( ${#conflicts[@]} > 0 )); then
    ii_conflicts_check "${conflicts[@]}" \
      || die "pack '$name' conflicts with an already-installed package (see above) — refusing; nothing changed"
  fi

  # Classify each member at runtime against the sync db (mirrors 40-packages.sh).
  for m in "${members[@]}"; do
    if pacman -Si "$m" &>/dev/null; then official+=("$m"); else aur+=("$m"); fi
  done
  (( ${#aur[@]} > 0 )) && _ensure_paru

  # No controlling terminal (e.g. the welcome card console) → fully non-interactive.
  local CONFIRM=(); [[ -t 0 ]] || CONFIRM=(--noconfirm)

  # Snapshot the installed set BEFORE the transaction so we can record EXACTLY
  # what was added (members + the deps they pull) — that resolved set is what
  # `remove`/`revert-all` later -Rns's. _resolved_since prints the new packages.
  local before
  before="$(pacman -Qq | sort)"
  _resolved_since() {   # echo, space-joined, the packages installed since $before
    local r; r="$(comm -13 <(printf '%s\n' "$before") <(pacman -Qq | sort) | tr '\n' ' ')"
    printf '%s' "${r% }"
  }

  echo "${C_B}>> installing pack '$name'${C_0} (${#official[@]} official, ${#aur[@]} AUR)"

  # REV-03 ATOMIC RECORDING. The old flow committed the official `pacman -S`
  # first and only `ledger_record`ed AFTER a later `paru -S`; if the AUR phase
  # die()'d, the official members stayed installed with NO ledger row — invisible
  # to `pack remove` and `revert-all`. Fix: whenever a member install partially
  # lands, the kind=pack row is recorded for what landed BEFORE we surface the
  # failure, so removal/revert always finds and undoes exactly what was added.
  if (( ${#official[@]} > 0 )); then
    if ! _sudo pacman -S --needed "${CONFIRM[@]}" "${official[@]}"; then
      _record_pack "$name" "$(_resolved_since)" "${members[*]}"
      die "official-repo install failed — recorded what landed; undo with: iictl pack remove $name"
    fi
  fi
  if (( ${#aur[@]} > 0 )); then
    if ! paru -S --needed "${CONFIRM[@]}" "${aur[@]}"; then
      # The official phase already committed; record it (+ any AUR member paru
      # managed to land) so it is not orphaned, THEN surface the real failure.
      _record_pack "$name" "$(_resolved_since)" "${members[*]}"
      die "AUR install via paru failed — recorded what landed; undo with: iictl pack remove $name"
    fi
  fi

  # Both package phases succeeded. Record the kind=pack row NOW — BEFORE post-add
  # — so a post-add hook that exit/die's (even though _run_hook subshell-fences
  # it) can never leave the installed members unrecorded.
  _record_pack "$name" "$(_resolved_since)" "${members[*]}"

  # Optional post-add hook (services/groups/fenced custom/*.lua via the shared
  # mutators — each ledger-records its own inverse). Subshell-fenced (_run_hook):
  # a stray exit/die cannot abort the engine now that the pack row is recorded.
  _run_hook "$name" post-add

  # Re-snapshot AFTER post-add: a hook may pull extra packages. Capture any net-new
  # ones into a SECOND kind=pack row so `revert-all pack:<name>` -Rns's them too
  # (the old code snapshotted before post-add and lost hook-installed packages).
  # The first row (recorded above, pre-hook) is guaranteed even if post-add died.
  local resolved recorded extra
  resolved="$(_resolved_since)"
  recorded="$(ledger_query pack "pack:$name" | head -n1 | cut -f4)"   # first row, col 4
  if [[ "$resolved" != "$recorded" ]]; then
    extra="$(comm -13 <(printf '%s\n' "$recorded" | tr ' ' '\n' | sort -u) \
                      <(printf '%s\n' "$resolved" | tr ' ' '\n' | sort -u) | tr '\n' ' ')"
    extra="${extra% }"
    [[ -n "${extra// /}" ]] && _record_pack "$name" "$extra" "post-add"
  fi

  if [[ -n "${resolved// /}" ]]; then
    ok "pack '$name' installed (added: $resolved) — reversible via: iictl pack remove $name"
  else
    ok "pack '$name' marked installed — all members were already present (nothing added)"
  fi
}

# _record_pack <name> <resolved-pkgs> <members-or-tag> — append ONE kind=pack
# ledger row for this pack (target=pack:<name>, packages=<resolved set>). Factored
# out (REV-03) so every code path — official-fail, AUR-fail, success, and the
# post-add top-up — records through the SAME primitive. An empty resolved set
# (every member already present) is recorded as-is so `remove` correctly removes
# nothing we did not add; revert-all reads column 4.
_record_pack() {
  local name="$1" resolved="$2" tag="$3"
  ledger_record pack "pack:$name" "$resolved" "" "members=$tag"
}

cmd_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: iictl pack remove <pack>"
  _not_root
  _pack_installed "$name" || die "pack '$name' is not installed (no ledger entry)"

  # Run the explicit per-pack inverse hook FIRST (so a service/group/fence the
  # post-add hook set is undone before the packages it may depend on go away).
  _run_hook "$name" post-remove

  # Delegate the package removal + ledger pruning to the SINGLE replay owner,
  # `iictl revert-all pack:<name>` (BLUEPRINT §3 "domains must NOT re-implement
  # ledger replay"). It does the offline-safe `pacman -Rns` of the recorded set
  # — no network, no [ii-extra] — prunes the row atomically, and re-runs doctor.
  echo "${C_B}>> removing pack '$name'${C_0} (via the shared revert engine)"
  local ra="$IICTL_D/revert-all"
  if command -v iictl >/dev/null 2>&1; then
    exec iictl revert-all "pack:$name"
  elif [[ -x "$ra" ]]; then
    exec "$ra" "pack:$name"
  else
    die "revert-all engine not found ($ra) — cannot remove '$name' cleanly"
  fi
}

cmd_usage() {
  cat <<EOF
${C_B}iictl pack${C_0} — install/remove/list curated optional software packs

Packs are curated name-lists that ride in the image as TEXT; their members are
installed ONLINE on demand (official repos via pacman, AUR via paru). Every
install is ledger-recorded, so removal is an exact, offline-safe pacman -Rns.
Nothing pack-related is baked into the ISO — only the few-KB lists.

usage:
  iictl pack list [--json]      list available packs (+ installed status / conflicts)
  iictl pack --spec             emit the iictl-tui chooser spec (JSON; drives 'iictl tweak pack')
  iictl pack install <pack>     install a pack's members online (records for undo)
  iictl pack remove  <pack>     remove exactly what the pack added (offline-safe)

A pack also reverts via the shared engine:
  iictl revert-all pack:<pack>  (or 'iictl revert-all pack:' for every pack)
EOF
}

case "${1:-help}" in
  list)            shift; cmd_list    "$@" ;;
  --spec|spec)     shift; cmd_spec    "$@" ;;
  install|add)     shift; cmd_install "$@" ;;
  remove|rm)       shift; cmd_remove  "$@" ;;
  help|-h|--help)  cmd_usage ;;
  *)               die "unknown subcommand: $1 (try: iictl pack help)" ;;
esac

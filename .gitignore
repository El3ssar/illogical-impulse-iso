# mkarchiso / prepare artifacts
build/
out/
*.log
.fetch-cache/

# Editor / OS noise
.DS_Store
*~
*.swp
*.swo
.idea/
.vscode/
__pycache__/
.claude/

# AUR local build scratch (regenerated by just prebuild)
overlay/aur-pkgbuilds/*/src/
overlay/aur-pkgbuilds/*/pkg/
overlay/aur-pkgbuilds/*/*.pkg.tar.*
overlay/aur-pkgbuilds/*/*.log

# Profile wallpapers stay machine-local (tens of MB of images)
profiles/*/skel/Pictures/

# Personal profiles stay machine-local — only the README ships
profiles/*
!profiles/README.md

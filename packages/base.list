# packages/base.list — distro baseline: present on the live ISO AND the
# installed system. Identity tools + login infrastructure only.
#
# NOT here: upstream rice deps (scraped from upstream PKGBUILDs by
# prepare.d/40-packages.sh), installer-only packages (installer.list),
# default apps (goodies.list), install-time choices (optional/*.list).

greetd
greetd-agreety
polkit
dbus-broker
xorg-xwayland
fastfetch
zram-generator
libnotify
chafa

# iictl-tui — the ratatui chooser renderer (#47). A local PKGBUILD under
# overlay/aur-pkgbuilds/ (built by prebuild → [ii-extra], pacstrapped into the
# squashfs), so it SURVIVES install as a normal /usr/bin package (no ii-verify
# exemption). Drives `iictl tweak <domain>` over each domain's `--spec` contract.
iictl-tui

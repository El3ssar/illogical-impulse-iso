// /etc/fastfetch/config.jsonc — system default. Per-user ~/.config/fastfetch
// takes precedence.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The distro icon, rendered via terminal graphics (kitty protocol) in
    // the rice's terminals; falls back to chafa ASCII art on TTYs.
    // The classic ASCII logo remains at /etc/illogical-impulse/logo.txt
    // (use: fastfetch --logo /etc/illogical-impulse/logo.txt).
    "logo": {
        "source": "/usr/share/pixmaps/illogical-impulse.png",
        "type": "auto",
        "width": 18,
        "padding": { "top": 1, "right": 3 },
        // token colors for the ASCII logo (fastfetch --logo /etc/illogical-impulse/logo.txt):
        // $1 = disc (: . ') rgb(60 64 86) — icon navy x2 for terminal visibility,
        // $2 = artwork (# * - =) rgb(69 221 188)
        "color": { "1": "38;2;60;64;86", "2": "38;2;69;221;188" }
    },
    "display": {
        "color": { "keys": "magenta", "title": "cyan" },
        "separator": " ❯ "
    },
    "modules": [
        "title", "separator",
        { "type": "os",       "key": " OS" },
        { "type": "host",     "key": "󰌢 Host" },
        { "type": "kernel",   "key": " Kernel" },
        { "type": "uptime",   "key": "󰅐 Uptime" },
        { "type": "packages", "key": " Packages" },
        { "type": "shell",    "key": " Shell" },
        { "type": "wm",       "key": " WM" },
        { "type": "terminal", "key": " Terminal" },
        { "type": "cpu",      "key": " CPU" },
        { "type": "gpu",      "key": "󰊴 GPU" },
        { "type": "memory",   "key": " Memory" },
        { "type": "disk",     "key": "󰋊 Disk" },
        "break", "colors"
    ]
}

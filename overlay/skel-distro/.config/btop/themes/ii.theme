# Illogical Impulse — btop theme "ii" (Catppuccin Mocha cold-start palette).
#
# UNOWNED seam: upstream ships no ~/.config/btop, so this static default can
# never collide with or be wiped by upstream's rsync --delete. It mirrors the
# OOB kitty-theme.conf cold-start palette. The opt-in recolour watcher
# (ii-theme-recolor.sh, off by default) live-rewrites the accent roles here from
# the finished Material colours; until then this is the baked default.
# Delete ~/.config/btop to fall back to btop's own built-in default theme.

theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[hi_fg]="#89b4fa"
theme[selected_bg]="#89b4fa"
theme[selected_fg]="#1e1e2e"
theme[inactive_fg]="#585b70"
theme[graph_text]="#cdd6f4"
theme[meter_bg]="#45475a"
theme[proc_misc]="#94e2d5"
theme[cpu_box]="#585b70"
theme[mem_box]="#585b70"
theme[net_box]="#585b70"
theme[proc_box]="#585b70"
theme[div_line]="#45475a"
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#89b4fa"
theme[cpu_end]="#f38ba8"
theme[free_start]="#89b4fa"
theme[free_mid]="#94e2d5"
theme[free_end]="#a6e3a1"
theme[cached_start]="#94e2d5"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#cba6f7"
theme[available_start]="#f9e2af"
theme[available_mid]="#fab387"
theme[available_end]="#f38ba8"
theme[used_start]="#a6e3a1"
theme[used_mid]="#f9e2af"
theme[used_end]="#f38ba8"
theme[download_start]="#89b4fa"
theme[download_mid]="#cba6f7"
theme[download_end]="#f5c2e7"
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#f9e2af"
theme[upload_end]="#f38ba8"
theme[process_start]="#89b4fa"
theme[process_mid]="#cba6f7"
theme[process_end]="#f38ba8"

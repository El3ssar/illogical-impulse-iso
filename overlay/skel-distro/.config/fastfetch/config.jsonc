// Illogical Impulse — fastfetch config (installed-user skel default).
//
// UNOWNED seam: upstream ships no ~/.config/fastfetch, so this static default
// can never collide with or be wiped by upstream's rsync --delete. NOTE: this is
// the INSTALLED-USER skel config and is intentionally DISTINCT from the live
// ISO's /etc/fastfetch/config.jsonc (a system default for the live session).
// Per-user config (this file) wins over the system one. Delete ~/.config/fastfetch
// to fall back to the /etc system default. Themed toward the Catppuccin-Mocha
// cold-start palette; keys/title use the rice accent family.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/pixmaps/illogical-impulse.png",
        "type": "auto",
        "width": 18,
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "color": { "keys": "blue", "title": "cyan" },
        "separator": " ❯ "
    },
    "modules": [
        "title", "separator",
        { "type": "os",       "key": " OS" },
        { "type": "host",     "key": "󰌢 Host" },
        { "type": "kernel",   "key": " Kernel" },
        { "type": "uptime",   "key": "󰅐 Uptime" },
        { "type": "packages", "key": " Packages" },
        { "type": "shell",    "key": " Shell" },
        { "type": "wm",       "key": " WM" },
        { "type": "terminal", "key": " Terminal" },
        { "type": "cpu",      "key": " CPU" },
        { "type": "gpu",      "key": "󰊴 GPU" },
        { "type": "memory",   "key": " Memory" },
        { "type": "disk",     "key": "󰋊 Disk" },
        "break", "colors"
    ]
}
